# Copy to .env and fill in the values without a default. Every setting is listed in docs/CONFIG.md.
# In the environment a setting's path uses "__" for ":", so FeedEater:Llm:ApiKey is FeedEater__Llm__ApiKey.
# Do not put quotes around values.

# --- Required -----------------------------------------------------------------------------------------------------

# Password for the bundled Postgres. Letters and digits only: it is also placed in a connection string.
POSTGRES_PASSWORD=

# Password for the web UI (/ui) and bearer token for the MCP endpoint (/mcp). Make one up: openssl rand -hex 32
Mcp__Token=

# API key for the model provider below (OpenAI by default: https://platform.openai.com/api-keys).
FeedEater__Llm__ApiKey=

# Bot token from @BotFather in Telegram (send /newbot).
FeedEater__Telegram__Token=

# Your numeric Telegram user id: the only person the bot answers. Leave 0 on the first start, send /start to your bot,
# copy the id it answers with here, then restart: docker compose up -d
FeedEater__Telegram__AllowedUserId=0

# --- Common -------------------------------------------------------------------------------------------------------

# Time zone for the digest time, quiet hours and shown dates (an IANA name such as Europe/Berlin).
FeedEater__TimeZone=UTC

# Any OpenAI-compatible endpoint, with its version path. Change it to use another provider or a gateway.
FeedEater__Llm__BaseUrl=https://api.openai.com/v1/

# Models, only if your provider uses other names. The embedding model must return 1536 dimensions.
# FeedEater__Llm__TriageModel=gpt-4.1-nano
# FeedEater__Llm__ReadModel=gpt-4.1-mini
# FeedEater__Llm__EmbedModel=text-embedding-3-small
# Only for a model that can shorten its output (text-embedding-3-large): the database column is 1536 wide.
# FeedEater__Llm__EmbedDimensions=1536

# --- Optional integrations: each is off until its settings are filled -----------------------------------------------

# Plane (project tracker): 💡 files an idea there instead of the local list.
# FeedEater__Plane__BaseUrl=
# FeedEater__Plane__Token=
# FeedEater__Plane__Workspace=
# FeedEater__Plane__FallbackProject=

# Karakeep (bookmarks): adds a 📌 button and imports your bookmarks as liked items.
# FeedEater__Karakeep__BaseUrl=
# FeedEater__Karakeep__Token=

# GitHub: the public stars of this user count as liked items.
# FeedEater__GitHub__User=

# Hindsight (memory): a weekly summary of your reading.
# FeedEater__Hindsight__BaseUrl=
# FeedEater__Hindsight__Token=

# Release watch: what you run, as a PINS.md path or https URL, or a JSON list (see config/watch.example.json).
# FeedEater__Watch__Source=
# FeedEater__Watch__FallbackPath=

# Miniflux, instead of the built-in feed reader: both are needed.
# FeedEater__Miniflux__BaseUrl=
# FeedEater__Miniflux__Token=
