<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Switchknife.Facts" Version="0.1.0" />
    <PackageReference Include="Switchknife.McpGuard" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../config/*.json" Link="config/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as FeedEater.Migrations.<file>; DatabaseMigrator filters on ".Migrations." -->
    <EmbeddedResource Include="../../db/migrations/*.sql" LinkBase="Migrations" />
    <EmbeddedResource Include="Ui/assets/app.css" LogicalName="FeedEater.Ui.app.css" />
    <EmbeddedResource Include="Ui/assets/swipe.js" LogicalName="FeedEater.Ui.swipe.js" />
    <EmbeddedResource Include="Ui/assets/swipe.css" LogicalName="FeedEater.Ui.swipe.css" />
    <EmbeddedResource Include="Ui/assets/swipe.webmanifest" LogicalName="FeedEater.Ui.swipe.webmanifest" />
    <EmbeddedResource Include="Ui/assets/swipe-sw.js" LogicalName="FeedEater.Ui.swipe-sw.js" />
    <EmbeddedResource Include="Ui/assets/swipe-icon.svg" LogicalName="FeedEater.Ui.swipe-icon.svg" />
    <!-- The interests used until the reader writes their own profile.json. -->
    <EmbeddedResource Include="../../profile.example.json" LogicalName="FeedEater.profile.example.json" />
    <InternalsVisibleTo Include="FeedEater.Tests" />
  </ItemGroup>

</Project>
