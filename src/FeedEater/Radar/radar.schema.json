{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrabovskyi.online/radar.schema.json",
  "title": "Tech radar",
  "description": "content/radar.json: what I adopt, trial, assess or hold. Personal repos only; the site renders it read-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quadrant", "ring", "since", "reason", "repoKind"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "quadrant": { "enum": ["infra", "data", "tooling", "process"] },
        "ring": { "enum": ["adopt", "trial", "assess", "hold"] },
        "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "result": { "type": "string", "maxLength": 500 },
        "repoKind": { "const": "personal" }
      }
    }
  }
}
